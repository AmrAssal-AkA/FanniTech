


generator client {
  provider = "prisma-client"
  output   = "../src/prisma/generated"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER @map("customer")
  ADMIN @map("admin")
  TECHNICIAN @map("technician")
}

enum AuthClient {
  WEB @map("web")
  MOBILE @map("mobile")
}


model User {
  id       String   @id @default(uuid())
  email     String   @unique
  name     String
  password  String
  phone    String?
  role    UserRole   @default(CUSTOMER)
  refreshTokens RefreshToken[]
  EmailVerifyAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


}

model RefreshToken {
  id     String  @id @default(uuid())
  userId String
  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId String
  token   String @unique
  deviceInfo String?
  client AuthClient
  revoke Boolean @default(false)
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}
